# Variáveis de ambiente para a aplicação Flask

# Modo de desenvolvimento (development ou production)
FLASK_ENV=development

# Chave secreta para sessões (MUDE ISSO EM PRODUÇÃO!)
SECRET_KEY=super-secret-key-change-me-in-production

# URL do banco de dados (opcional - por padrão usa SQLite)
# Para PostgreSQL: postgresql://user:password@localhost/dbname
# Para MySQL: mysql://user:password@localhost/dbname
# DATABASE_URL=sqlite:///instance/data_bank.db

# Porta da aplicação (padrão: 5000)
PORT=5000

# Credenciais de admin (opcional - para criar usuário inicial)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123
